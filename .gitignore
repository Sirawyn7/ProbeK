# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
build/
dist/
.pytest_cache/

# Claude Code harness internals (not project files)
.claude/

# ProbeK runtime data (large, regenerable from official NCBI/UCSC sources)
reference_data/
results/

# Sequence/BLAST cache — regenerable from reference_data + input CSVs; entries
# are tied to a specific reference_db_version fingerprint that a fresh clone
# won't have anyway, so there's no value in versioning it.
probek_cache.sqlite3

# User-dropped probe data — working files, not meant for version control
input_csvs/*.csv
!input_csvs/README.md

# Windows "Mark of the Web" sidecar files -- appear when a downloaded ZIP is
# extracted through Windows Explorer into a WSL folder (NTFS Alternate Data
# Streams get materialized as real files since ext4 has no ADS support)
*Zone.Identifier*
